{
  "essential": {
    "graphic_data_url": "data.csv",
    "dateFormat": "%Y",
    "colour_palette": ["#27a0cc", "#003c57", "#003C57", "#A8BD3A", "27A0CC"],
    "legendLabels": ["Take-up rate by age of employee", "Overall rate"],
    "legendStyle": "rect",
    "sourceText": ["HM Revenue & Customs – Coronavirus Job Retention Scheme statistics"],
    "draggable": false,
    "annotationsChart": [
      { "xVal": "1971",
        "yVal": -8,
        "path": "",
        "text": "Age",
        "textOffset": [0,0]
      },
      { "xVal": "1926",
        "yVal": 50,
        "path": "",
        "text": "The youngest and oldest workers were most likely to be furloughed",
        "textOffset": [0,0]
      }
    ],
    "wordwrap": [30, 25, 10],
    "annoAlign": ["end", "start", "end"],
    "annotationBullet": [],
    "markers": false,
    "yAxisLabel": "%",
    "yAxisScale": [0,70],
    "ticksEvery":{
      "sm":4,
      "md":2,
      "lg":5
    }
  },
  "optional": {
    "margin": {
      "sm":{
        "top":60,
        "right":50,
        "bottom":0,
        "left":40
      },
      "md":{
        "top":60,
        "right":50,
        "bottom":0,
        "left":40
      },
      "lg":{
        "top":60,
        "right":50,
        "bottom":0,
        "left":40
      }
    },

    "aspectRatio": {"sm":[16, 13],"md":[16,12],"lg":[16,8]},

    "mobileBreakpoint": 414,
    "midBreakpoint":600,

    "y_num_ticks": {"sm":6, "md":6, "lg":8},
    "annotateLineX1_Y1_X2_Y2": [
      [
        [],
        []
      ]
    ],
    "annotateRect": [{
      "topLeft":[],
      "bottomRight":[],
      "fill":"#888",
      "opacity":0.5
      }],
    "centre_line": false,
    "centre_line_value": 100
  }
}

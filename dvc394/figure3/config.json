{
    "essential" : {
            "graphic_data_url": "data.csv",
        
            "dateFormat": "%Y",
            
            "legendLabels" : ["Without private pension", "With private pension"],
            "legendStyle": "line", 
            "colour_palette": ["#1983AC", "#E5C338"],
            
            "sourceText":["Effects of taxes and benefits on UK household income, Office for National Statistics"],
            "sourceURL":["https://www.ons.gov.uk/peoplepopulationandcommunity/personalandhouseholdfinances/incomeandwealth/bulletins/theeffectsoftaxesandbenefitsonhouseholdincome/previousReleases"],
            "draggable": false,
            "annotationsChart" : [
              {
                "xVal": "1978",
                "yVal": 300,
                "path": "",
                "text": "In 1977, the average of a household with private pensions income was around 4.5 times that of a household without",
                "textOffset": [0,0]
              },
               
              {
                "xVal": "2014",
                "yVal": 250,
                "path": "",
                "text": "By 2015/16 this had grown to 14 times as high",
                "textOffset": [0,0]
              }
            ],
            
            "wordwrap":[20,20,10],
            "annoAlign": ["start", "end"],
            "annotationBullet" : [],
        
            "circles" : false,    
           "annotationCXCY":[
                ["2010","6"],
                ["2010","1.7"]
            ],
        
            "yAxisLabel":"Original income (£ per week)",
            "yAxisScale":[0,400],   
            "yAxisBreak": true,
            "yAxisBreak_sm_md_lg": [20,20,20]            
    },
    
    "optional" : {
            "margin_sm": [50, 15, 55, 35],
            "margin_md": [50, 15, 55, 35],
            "margin_lg": [50, 15, 55, 35],
        
            "aspectRatio_sm" : [16,13],
            "aspectRatio_md" : [16,12],
            "aspectRatio_lg" : [16,10],
        
            "mobileBreakpoint" : 600, 
            
            "xAxisTextFormat_sm_md_lg" : ["%y", "%Y", "%Y"], 
                
            "x_num_ticks_sm_md_lg" : [6,10,22],    
            "y_num_ticks_sm_md_lg" : [5,11,11],
        
            "lineMarkers" : false,
        
            "vertical_line" : false,
            "annotateLineX1_Y1_X2_Y2" : [],
        
            "annotateRect" : false,
            "annotateRectX_Y" : [],
            "lineColor_opcty" : [],
        
            "centre_line" : false,
            "centre_line_value" : 25
    }
}



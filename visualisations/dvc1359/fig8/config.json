      "md": {
        "top": 30,
        "right": 165,
        "bottom": 25,
        "left": 40
      },
      "lg": {
        "top": 30,
        "right": 165,
        "bottom": 25,
        "left": 40
      }
    },

    "aspectRatio": {
      "sm": [16, 7],
      "md": [16, 7],
      "lg": [16, 6]
    },

    "mobileBreakpoint": 500,
    "middleBreakpoint": 600,

    "x_ticks_every": {
      "sm": 100,
      "md": 50,
      "lg": 79
    },
    "y_num_ticks": {

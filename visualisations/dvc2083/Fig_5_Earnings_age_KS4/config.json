{
  "essential": {
    "graphic_data_url": "data.csv",
    "dateFormat": "%Y",
    "displayTicksFormat": "",
    "colour_palette": [{
        "key": "FSM",
        "colour": "#27A0CC"
      },
      {
        "key": "Non-FSM",
        "colour": "#206095"
      },
      {
        "key":"Independent",
        "colour":"#871A5B"
      }
    ],
    "categorySort": {
      "on":true,
      "sortby":["Lowest quintile","2nd quintile","3rd quintile","4th quintile","Highest quintile"]
      },

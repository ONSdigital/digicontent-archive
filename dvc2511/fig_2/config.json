{
  "essential": {
    "graphic_data_url": "regions.csv",
    "dateFormat": "%d/%m/%Y",
    "displayTicksFormat":"%Y",
    "colour_palette": [
      {
        "key": "Detached",
        "colour": "#27A0CC"
      },
      {
        "key": "Flat",
        "colour": "#27A0CC"
      },
      {
        "key": "Semi-detached",
        "colour": "#27A0CC"
      },
      {
        "key": "Terraced",
        "colour": "#27A0CC"
      }
    ],
    "categorySort": {
      "on":true,
      "sortby":["Detached", "Semi-detached", "Terraced", "Flat"]
      },
    "sourceText": ["UK House Price Index, Bank of England"],
    "xAxisLabel": "",
    "yAxisLabel": "",
    "yAxisScale": "auto_zero_max_total",
    "screenreadertext":"This graphic shows the indicative monthly mortgage payments for average priced properties over time for four property types: detached, semi-detached, flat and terraced. The underlying data is available in the accompanying data download."
  },
  "optional": {
    "margin": {
      "sm": {
        "top": 20,
        "right": 15,
        "bottom": 45,
        "left": 50
      },
      "md": {
        "top": 20,
        "right": 15,
        "bottom": 50,
        "left": 50
      },
      "lg": {
        "top": 20,
        "right": 15,
        "bottom": 45,
        "left": 50
      }
    },
    "chart_every":{
      "sm": 2,
      "md": 2,
      "lg": 2
    },
    "aspectRatio": {
      "sm": [16, 12],
      "md": [16, 8],
      "lg": [16, 8]
    },
    "legendHeight":{
      "sm": 45,
      "md": 30,
      "lg": 30
    },

    "mobileBreakpoint": 480,
    "middleBreakpoint": 670,
    "x_ticks_every": {
      "sm": 1,
      "md": 1,
      "lg": 1
    }
  }
}

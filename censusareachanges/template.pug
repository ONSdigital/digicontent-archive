mixin rel(i)
    - console.log("rel")
    //-rel
    - var obj = place.data[s[i][0]].perc.change
    - var bigChange = s[i][3]
    - function valnoprint(x) { return parseFloat(x.toPrecision(2)) }
    p
        | In 2021, #[+pc(data[s[i][0]].perc[2021][bigChange])] of !{place.nameNoThe} residents 
        | #[+value(topics[s[i][0]][bigChange]['verb_past_samp_er'])], 
        - let highrel = Object.keys(data[s[i][0]].perc[2021]).reduce((a, b) => data[s[i][0]].perc[2021][a] > data[s[i][0]].perc[2021][b] ? a : b)
        if (highrel == bigChange)
            | making it the most common response in this local authority area
            | (up from #[+pc(data[s[i][0]].perc[2011][bigChange])] in 2011).
        else
            | up from #[+pc(data[s[i][0]].perc[2011][bigChange])] in 2011.
            | The #[+value( (data[s[i][0]].perc['change'][bigChange]>0)?'rise':'fall')] of 
            | #[+value( Math.abs(data[s[i][0]].perc['change'][bigChange]), {'FORMAT': "0.0"})]
            | percentage points was the largest increase of all broad religious groups in !{place.name}.
        | Because the census question about religious affiliation is voluntary and has varying response rates, caution is needed when comparing figures between different areas or between censuses.
    p
        | Across !{parent}, the #[+percentASR(i)] of #[+value(topics[s[i][0]][bigChange]['adj_noun_er'])]
        if (pcnoprint(rgn.data[s[i][0]].perc[2011][bigChange]) != pcnoprint(rgn.data[s[i][0]].perc[2021][bigChange]))
            if ( ( rgn.data[s[i][0]].perc[2021][bigChange] - rgn.data[s[i][0]].perc[2011][bigChange] ) > 0 )
                | increased
            else
                | decreased
            | from #[+pc(rgn.data[s[i][0]].perc[2011][bigChange])] 
            | to #[+pc(rgn.data[s[i][0]].perc[2021][bigChange])]
        else 
            | remained at #[+pc(rgn.data[s[i][0]].perc[2021][bigChange])]
        if (cou.name!='Wales')
            | , while across !{cou.name} the percentage
            if (pcnoprint(cou.data[s[i][0]].perc[2011][bigChange]) != pcnoprint(cou.data[s[i][0]].perc[2021][bigChange]))
                | #[+value((cou.data[s[i][0]].perc[2011][bigChange]<cou.data[s[i][0]].perc[2021][bigChange])?'increased':'decreased')]  from
                | #[+pc(cou.data[s[i][0]].perc[2011][bigChange])] to 
                | #[+pc(cou.data[s[i][0]].perc[2021][bigChange])]
            else 
                | remained at #[+pc(cou.data[s[i][0]].perc[2021][bigChange])]
        |.
    p 
        - var objPerc = Object.assign({}, place.data[s[i][0]].perc[2021]) 
        - delete objPerc[bigChange]
        - delete objPerc['all']
        - delete objPerc['Religionnotstated']
        - var bigPerc1 = Object.keys(objPerc).reduce((a, b) => (objPerc[a] > objPerc[b]) ? a : b)
        - delete objPerc[bigPerc1]
        - var bigPerc2 = Object.keys(objPerc).reduce((a, b) => (objPerc[a] > objPerc[b]) ? a : b)
        - delete objPerc[bigPerc2]
        - var bigPerc3 = Object.keys(objPerc).reduce((a, b) => (objPerc[a] > objPerc[b]) ? a : b)
        | In 2021, #[+pc(data[s[i][0]].perc[2021][bigPerc1])] of people #[+value(place.preposition)] #[+value(place.name)]
        | #[+value(topics[s[i][0]][bigPerc1]['verb_past_samp_er'])]
        | (#[+value(ud((data[s[i][0]].perc[2021][bigPerc1] - data[s[i][0]].perc[2011][bigPerc1]), 'up', 'down'))]
        | from #[+pc(data[s[i][0]].perc[2011][bigPerc1])]),
        | while #[+pc(data[s[i][0]].perc[2021][bigPerc2])] #[+value(topics[s[i][0]][bigPerc2]['verb_past_samp_er'])]
        | (#[+value(ud((data[s[i][0]].perc[2021][bigPerc2] - data[s[i][0]].perc[2011][bigPerc2]), 'up', 'down'))] 
        | from #[+pc(data[s[i][0]].perc[2011][bigPerc2])] the decade before).
    p 
        | There are many factors that can cause changes to the religious profile of an area, such as a changing age structure or residents relocating for work or education. Changes may also be caused by differences in the way individuals chose to self-identify between censuses. Religious affiliation is the religion with which someone connects or identifies, rather than their beliefs or religious practice.
    a(href="https://www.ons.gov.uk/peoplepopulationandcommunity/culturalidentity/religion/bulletins/religionenglandandwales/census2021")
        | Read the bulletin Religion, England and Wales: Census 2021.
    p 
        | 


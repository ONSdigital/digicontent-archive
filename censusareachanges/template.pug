    //-behindCurrent3Reg
    - let rl = regional_rank_2021
    - var topranks_3 = t_b_21_reg.filter( e=> (rl<0)? (e['rank'] == -1) : (e['rank'] == 1) )
    - var secranks_3 = t_b_21_reg.filter( e=> (rl<0)? (e['rank'] == -2) : (e['rank'] == 2) )
    | Across the region,
    | only 
    | #[+placeLink(topranks_3[0]['name'])]
    | #[+county(topranks_3[0]['name'])]
    | (#[+pc(topranks_3[0]['2021'])]) 
    if (topranks_3.length == 1)
        | and 
        | #[+placeLink(secranks_3[0]['name'])]
        | #[+county(secranks_3[0]['name'])]
        | (#[+pc((secranks_3[0]['2021']))]) 
        | had a #[+value(rl>0?"higher":"lower")] #[+percentASR(i)] of #[+value(topic(i).adj_noun)].
        | #[+small_disclaimer(topranks_3[0].name)]
        | #[+small_disclaimer(secranks_3[0].name)]
    else
        | and 
        | #[+placeLink(topranks_3[1]['name'])]
        | #[+county(topranks_3[1]['name'])]
        | (#[+pc((topranks_3[1]['2021']))]) 
        | had a #[+value(rl>0?"higher":"lower")] #[+percentASR(i)] of #[+value(topic(i).adj_noun)].
        | #[+small_disclaimer(topranks_3[0].name)]
        | #[+small_disclaimer(topranks_3[1].name)]

mixin behindCurrent2Nat(i)
    - console.log("behindCurrent2Nat")
    //-behindCurrent2Nat
    - let rl = national_rank_2021 
    - let top_rank = t_b_21_nat.find( e=> (rl<0)? (e['rank'] == -1) : (e['rank'] == 1) )
    | Across the country,
    | only 
    | #[+placeLink(top_rank['name'])]
    | #[+county(top_rank['name'])], with #[+pc(top_rank['2021'])],
    | had a #[+value((rl>0)?'higher':'lower')] #[+percentASR(i)]
    | #[+value(topic(i).verb)]
    | .
    | #[+small_disclaimer(top_rank.name)]

mixin behindCurrent3Nat(i)
    - console.log("behindCurrent3Nat")
    //-behindCurrent3Nat
    - let rl = national_rank_2021
    - var topranks_3 = t_b_21_nat.filter( e=> (rl<0)? (e['rank'] == -1) : (e['rank'] == 1) )
    - var secranks_3 = t_b_21_nat.filter( e=> (rl<0)? (e['rank'] == -2) : (e['rank'] == 2) )
    | Across the country,
    | only 
    | #[+placeLink(topranks_3[0]['name'])]
    | #[+county(topranks_3[0]['name'])]
    | (#[+pc(topranks_3[0]['2021'])]) 
    if (topranks_3.length == 1)
        | and 
        | #[+value(secranks_3[0]['name'])]
        | #[+county(secranks_3[0]['name'])]
        | (#[+pc((secranks_3[0]['2021']))]) 
        | had a #[+value(rl>0?"higher":"lower")] #[+percentASR(i)] of #[+value(topic(i).adj_noun)].
        | #[+small_disclaimer(topranks_3[0].name)]
        | #[+small_disclaimer(secranks_3[0].name)]
    else
        | and 
        | #[+value(topranks_3[1]['name'])]
        | #[+county(topranks_3[1]['name'])]
        | (#[+pc((topranks_3[1]['2021']))]) 
        | had a #[+value(rl>0?"higher":"lower")] #[+percentASR(i)] of #[+value(topic(i).adj_noun)].
        | #[+small_disclaimer(topranks_3[0].name)]
        | #[+small_disclaimer(topranks_3[1].name)]

mixin CurrentRankReg(i)
    - console.log("CurrentRankReg")
    //-CurrentRankReg
    if (Math.abs(regional_rank_2021)<4)
        | #[+nowHasReg(i)]
    if (Math.abs(regional_rank_2021)==1)
        | #[+nextHighestReg(i)]
    else if (Math.abs(regional_rank_2021)==2)
        | #[+behindCurrent2Reg(i)]
    else if (Math.abs(regional_rank_2021)==3)
        | #[+behindCurrent3Reg(i)]

mixin CurrentRankNat(i)
    - console.log("CurrentRankNat")
    //-CurrentRankNat
    if (Math.abs(national_rank_2021)<4)
        | #[+nowHasCou(i)]
    if (Math.abs(national_rank_2021)==1)
        | #[+nextHighestNat(i)]
    else if (Math.abs(national_rank_2021)==2)
        | #[+behindCurrent2Nat(i)]
    else if (Math.abs(national_rank_2021)==3)
        | #[+behindCurrent3Nat(i)]

mixin percSizeChange(i)
    - var ra = data[s[i][0]][s[i][1]+"_rank"][2021][s[i][3]]
    - var ra_11 = data[s[i][0]][s[i][1]+"_rank"][2011][s[i][3]] 
    - console.log("percSizeChange")
    //-percSizeChange
    recordSaid('SIZE')
    | #[+sent1Perc(i)]
    | #[+agestandard(i)]
    //- | #[+healthDisclaimer(i)]
    if ( (Math.sign(ra)!=Math.sign(ra_11)) | (Math.abs(ra-ra_11) > 33) )
        p #[+overtake(i)]
    else
        p #[+sent2Perc(i)]
    p #[+sent3Perc(i)]

mixin mainPercSection(i)
    - console.log("mainPercSection")
    //-mainPercSection
    - other_1 = chains[s[i][3]][0]
    - other_2 = chains[s[i][3]][1]
    - local_2021_other_variable1 = data[s[i][0]][s[i][1]][2021][other_1] 
    - local_2011_other_variable1 = data[s[i][0]][s[i][1]][2011][other_1] 
    - other_national_rank_2021 = data[s[i][0]][s[i][1]+"_rank"]['2021'][other_1]
    - local_2021_other_variable2 = data[s[i][0]][s[i][1]][2021][other_2] 
    - local_2011_other_variable2 = data[s[i][0]][s[i][1]][2011][other_2] 

    - t_b_change_reg = data[s[i][0]][s[i][1]+'_rank_local'].top_bottom_change[s[i][3]]
    - t_b_change_nat = data[s[i][0]][s[i][1]+'_rank'].top_bottom_change[s[i][3]]
    - t_b_21_reg = data[s[i][0]][s[i][1]+"_rank_local"]['top_bottom'][s[i][3]]
    - t_b_21_nat = data[s[i][0]][s[i][1]+"_rank"]['top_bottom'][s[i][3]]

    if ((stories[i].type.includes('natRank')) & (Math.sign(national_rank_change) == Math.sign(local_change)))
        | #[+nationalRankStory(i)]
    else if ((stories[i].type.includes('regBuck'))|(eq(stories[i].type, ['regBuck', 'general']))) 
        - var curBuck = 'regBuck'
        | #[+buck(i, curBuck)]
    else if ((stories[i].type.includes('couBuck'))|(eq(stories[i].type, ['couBuck', 'general'])))
        - var curBuck = 'couBuck'
        | #[+buck(i, curBuck)]
    else if ((stories[i].type.includes('locRank')) & (Math.sign(regional_rank_change) == Math.sign(local_change)))
        | #[+regionalRankStory(i)]
    else if ((stories[i].type.includes('nearBuck'))&(!hasSaid('BUCK'))|(eq(stories[i].type, ['nearBuck', 'general'])))
        recordSaid('BUCK')
        - var curBuck = 'nearBuck'
        | #[+buck(i, curBuck)]
    else if ((stories[i].type.includes('couDiff'))|(stories[i].type.includes('regDiff'))|(stories[i].type.includes('nearDiff')))
        deleteSaid('SIZE')
        | #[+difference(i)]
    else
        | #[+percSizeChange(i)]        

- function highest_k_v(obj) { return Object.keys(obj).reduce((a, b) => obj[a] > obj[b] ? a : b) };
- function list_k_v(obj) { return Object.keys(obj).map( k => [ k, obj[k] ] ).sort(function(a, b){return b[1] - a[1] }) }


mixin health(i)
    - let vg1 = data.health.perc[2011]['Age-standardised proportion: Very good health']
    - let vg2 = data.health.perc[2021]['Age-standardised proportion: Very good health']
    - let vgc = vg2 - vg1
    - let vb1 = data.health.perc[2011]['Age-standardised proportion: Very bad health']
    - let vb2 = data.health.perc[2021]['Age-standardised proportion: Very bad health']
    - let vbc = vb2 - vb1
    - let g1 = data.health.perc[2011]['Age-standardised proportion: Good health']
    - let g2 = data.health.perc[2021]['Age-standardised proportion: Good health']
    - let gc = g2 - g1
    - let b1 = data.health.perc[2011]['Age-standardised proportion: Bad health']
    - let b2 = data.health.perc[2021]['Age-standardised proportion: Bad health']
    - let bc = b2 - b1
    h2(class="section-title" id=s[i][0]) Health !{place.preposition} !{place.nameNoThe}
    p
        | In 2021, #[+pc(vg2)] of !{place.nameNoThe} residents described their health as "very good", 
        if (Math.abs(vgc) == 0 )
            | the same level as in 2011.
        else 
            | #[+value((vgc>0)? 'increasing':'decreasing' )]
            |  from #[+pc(vg1)] in 2011.
        | Those describing their health as "good" 
        if (Math.abs(gc) == 0 )
            | remained at #[+pc(g2)].
        else
            | #[+value((gc>0)? 'rose':'fell' )]
            | from #[+pc(g1)] to #[+pc(g2)]. 
        | These are age-standardised proportions.
    | #[+agestandard(i)]
    p 
        | The proportion of !{place.nameNoThe} residents describing their health as "very bad"
        if (Math.abs(vbc) < 0.2 )
            if (Math.abs(vbc) > 0 )
                | was #[+pc(vb2)] (similar to 2011),
            else 
                | remained #[+pc(vb2)],
        else 
            | #[+value((vbc>0)? 'increased':'decreased' )] 
            | from #[+pc(vb1)] to #[+pc(vb2)],
        | while those describing their health as "bad"
        if (Math.abs(bc) < 0.2 )
            if (Math.abs(bc) > 0 )
                | was #[+pc(b2)] (similar to 2011).
            else
                | remained #[+pc(b2)].
        else 
            | #[+value((bc>0)? 'rose':'fell' )] 
            | from #[+pc(b1)] to #[+pc(b2)].
    | #[+healthExplain]

//- Deals with all percentage based variables
mixin percSection(i)
    - console.log("percSection")
    //- Health section
    if (s[i][0] == 'health')
        | #[+health(i)]
    //-percSection
    else if (s[i][0] == 'cob')
        //- If the section is based on country of birth data use the cob mixin
        | #[+cob(i)]
    else
        | #[+headline(i)]
        if ((s[i][0] == 'religion')|(s[i][0] == 'ethnicity'))
            //- Religion stories use the ethrel mixin
            | #[+ethrel(i)]
        else if (s[i][0] == 'welsh')
            //-  Welsh language stories have their own mixin
            | #[+welsh(i)]
        else
            //- All other percentage stories a routed to the mainPercSection mixin
            | #[+mainPercSection(i)]

mixin rou(x)
    | #[+value(Math.round(x*10)/10)]


mixin popChartHead(i)
    - console.log("popChartHead")
    - let comp_word = uds(data.population.value['change_p'].Population, rgn.data.population.value['change_p'].Population , "higher", "lower", "similar")
    //-popChartHead
    h4 
        if (data.population.value['change_p'].Population>0)
            | Population growth was #[+value(comp_word)]
            | #[+value(place.preposition)] !{place.name}
            if (comp_word=='similar')
                | to #[+value(parent)] as a whole
            else
                | than across #[+value(parent)]
        else if (data.population.value['change_p'].Population==0)
            | The size of !{place.nameNoThe+"'s"} population 
            | didn't change between the last two censuses
        else 
            | The population of !{place.name}
            | #[+value((data.population.value['change_p'].Population<0)?'decreased':'increased')]
            | by around #[+pc(Math.abs(data.population.value['change_p'].Population))]

mixin ageChartHead(i)
    - console.log("ageChartHead")
    - let top_pos = data.ageband.absChange['pos'][0][0]
    //-ageChartHead
    h4 
        - function pcnoprint(x) { if (Math.abs(x)<10) { return Math.round(x*10)/10 }  else { return Math.round(x) } }
        - function valnoprint(x) { return parseFloat(x.toPrecision(2)) }
        - var band_change = data['ageband']['perc']['change'][top_pos]
        | The share of residents aged 
        | #[+value(topics['agemed'][top_pos]['between'])] 
        | #[+value((band_change>0)?'increased':'decreased')]
        | by #[+value(Math.abs(band_change), {'FORMAT': "0.0"})] percentage points
        | between 2011 and 2021
    h5 
        | 

mixin chartTitle(i)
    - console.log("chartTitle")
    //-chartTitle
    if !(isTopic)
        if (s[i][0] == 'cob')
            | #[+cobChartHead(i)]
        else if (s[i][0] == 'population')
            | #[+popChartHead(i)]
        else if (s[i][0] == 'agemed')
            | #[+ageChartHead(i)]
        else if ((s[i][0] == 'religion')|(s[i][0] == 'ethnicity'))
            | #[+ethrelChartHead(i)]
        else if ( stories[i]['current'] == "here21" )
            | #[+chartTitleSize(i)]
        else
            | #[+chartTitleChange(i)]

mixin section(i)
    - console.log("section") 
    //-section
    deleteSaid('ASR')
    if (s[i][1] == 'value')
        if (s[i][0] == 'agemed')
            h2(class="section-title" id=s[i][0])
                | #[+subheadAge(i)]
            p #[+sent1Age(i)]
            p #[+sent2Age(i)]
            p #[+sent3Age(i)]
        else if (s[i][0] == 'population')
            - percent_change = data[s[i][0]]['value']['change_p'][s[i][3]]/100
            - regional_percent_change = rgn.data[s[i][0]]['value']['change_p'][s[i][3]]/100
            - national_percent_change = cou.data[s[i][0]]['value']['change_p'][s[i][3]]/100
            - national_rank_change = data[s[i][0]][s[i][1]+"_rank"]['change_p'][s[i][3]]
            - regional_rank_change = data[s[i][0]][s[i][1]+"_rank_local"]['change_p'][s[i][3]]

            h2(class="section-title" id=s[i][0])
                | #[+population_heading(i)]
            p #[+sent1pop(i)]
            p #[+sent2pop(i)]
            p #[+density]
            p This article generally uses percentages to enable comparisons over time and between areas. The percentage point change is also used to show the difference between the 2011 and 2021 percentages.
            if (['the City of London', 'the Isles of Scilly'].includes(place.name))
                p Measures for areas with small populations, such as !{place.name}, may be less robust than larger local authorities.
    if (s[i][1] == 'perc')
        //- All percentage based stories go through the percSection mixin
        | #[+percSection(i)]
    | #[+disclaimers(i)]
    //- All chart titles go through the chartTitle mixin
    | #[+chartTitle(i)]
    //-  Escape code where we insert a chart
    div#esc123

| #[+standfirst]
div#esc123

each i in [...Array(s.length).keys()]
    - deleteSaid('agestandard')
    - console.log(" * s", s[i][0])

    - local_2011 = data[s[i][0]][s[i][1]]['2011'][s[i][3]]
    - local_2021 = data[s[i][0]][s[i][1]]['2021'][s[i][3]]
    - local_change = data[s[i][0]][s[i][1]]['change'][s[i][3]]

    - regional_2011 = rgn.data[s[i][0]][s[i][1]]['2011'][s[i][3]]
    - regional_2021 = rgn.data[s[i][0]][s[i][1]]['2021'][s[i][3]]
    - regional_change = rgn.data[s[i][0]][s[i][1]]['change'][s[i][3]]

    - national_2011 = cou.data[s[i][0]][s[i][1]]['2011'][s[i][3]]
    - national_2021 = cou.data[s[i][0]][s[i][1]]['2021'][s[i][3]]
    - national_change = cou.data[s[i][0]][s[i][1]]['change'][s[i][3]]

    - near_2011 = near.data[s[i][0]][s[i][1]]['2011'][s[i][3]]
    - near_2021 = near.data[s[i][0]][s[i][1]]['2021'][s[i][3]]
    - near_change = near.data[s[i][0]][s[i][1]]['change'][s[i][3]]

    - national_rank_2021 = data[s[i][0]][s[i][1]+"_rank"]['2021'][s[i][3]]
    - regional_rank_2021 = data[s[i][0]][s[i][1]+"_rank_local"]['2021'][s[i][3]]
    - national_rank_change = data[s[i][0]][s[i][1]+"_rank"]['change'][s[i][3]]
    - regional_rank_change = data[s[i][0]][s[i][1]+"_rank_local"]['change'][s[i][3]]

    if (s.length>i)
        //-  All sections begin with the 'section'
        | #[+section(i)]

//- Sometimes we need to remove 'the' from the start of a place name
- function removeThe(name) { return (name.substring(0, 4) == 'the ' )?  name.substring(4) : name }

//- Return value rounded to 1 dp to check if values displayed will be appear the same in text
- function pcnoprint(x) { return Math.round(x*10)/10 }

//- Generate a percentage 
mixin pc(x)
    | #[+value(x/100, {'FORMAT': '0.0%'})] 

//- Generate a percentage rounded
mixin pcr(x)
    | #[+value(x/100, {'FORMAT': '0%'})] 

mixin small_disclaimer(x)
    if ((x=='City of London') & (!hasSaid('CoLDisc')))
        recordSaid('CoLDisc')
        p Because of its small size, comparisons to City of London should be made with caution. 
    else if ((x=='Isles of Scilly') & (!hasSaid('IoSDisc')))
        recordSaid('IoSDisc')
        p Because of its small size, comparisons to Isles of Scilly should be made with caution. 

mixin county(p)
    if (countyLU[p])
        if (fuzz(countyLU[p], p))
            if (countyLU[p]!=countyLU[place.name])
                | in #[+value(countyLU[p])]
        else if ((regionLU[p])&(regionLU[place.name]))
            if (regionLU[p]!=regionLU[place.name])
                | in #[+value(uncap1(regionThe(regionLU[p])))]
    else if (regionLU[p]&(regionLU[place.name]))
        if (regionLU[p]!=regionLU[place.name])
            | in #[+value(uncap1(regionThe(regionLU[p])))]


mixin nearest00(x)
    | #[+value( Math.abs( Math.round(x/100)*100 ) )]

mixin regionalAve(i)
    if (rgn.name=='Wales')
        | #[+percentASR(i)] across Wales
    else
        | regional #[+percentASR(i)]

mixin healthExplain
    p These data reflect people’s own opinions in describing their overall health on a five point scale, from very good to very bad.


- function rev_rank(r, n) { if (r>0) return r; else return r+n+1 }
mixin overtake(i)
    - console.log("overtake")
    //-overtake
    if (rgn.name=='Wales')
        - loc = "_local"
    - var ove = data[s[i][0]][s[i][1]+"_rank"]['overtake'][s[i][3]]
    - var ra = data[s[i][0]][s[i][1]+"_rank"][2021][s[i][3]]
    - var ra_11 = data[s[i][0]][s[i][1]+"_rank"][2011][s[i][3]] 
    if ((ra<10) & (ra>0) & (ove.length>0) & (local_change >0 ))
        | During this period, !{place.name} 
        | #[+value(ud(ra, 'overtook', 'fell below'))] 
        if (ove.length<4)
            eachz item in ove with { separator: ',', last_separator: 'and' }
                | #[+placeLink(item)] 
        else if (ove.length>3)
            | #[+value(nuword(ove.length))] 
            | local authority 
            | #[+value(pluralize('area', ove.length))],
            | including #[+placeLink(ove[0])] 
            | and #[+placeLink(ove[1])],
        | to become the #[+value((country=="Wales")?"Welsh":"English")] local authority area with the
        | #[+value(jointrank(ra, s[i], "", place, "")[0])]
        | #[+value(ud(ra, (ord(Math.abs(ra))+"highest"), (ord(Math.abs(ra))+"lowest")))]
        | #[+percentASR(i)] of #[+value(topics[s[i][0]][s[i][3]].adj_noun_s)]
        | #[+alongside(jointrank(ra, s[i], "", place, ""))]
        | .
    else if (parent=='Wales')
        if ((ra_11 == ra) & (jointrank(ra_11, s[i], "", place, "_11")[0] == jointrank(ra, s[i], "", place, "")[0]))
            | During this period, !{place.name} 
            | remained the 
            | #[+value(jointrank(ra, s[i], "", place, "")[0])]
            | #[+value(ud(ra, (ord(Math.abs(ra))+"highest"), (ord(Math.abs(ra))+"lowest")))] for the share of #[+value(topics[s[i][0]][s[i][3]].adj_noun_s)]
            | #[+alongside(jointrank(ra, s[i], "", place, ""))] 
            - let last_letter = topics[s[i][0]][s[i][3]].adj_noun_s[topics[s[i][0]][s[i][3]].adj_noun_s.length-1]
            | !{ (last_letter==")") ? "" : "(" } out of all
            | #[+value((country=="England")?"309 English":"22 Welsh")] local authority areas !{ (last_letter==")") ? "" : ")" }
            | .
        if ( ( Math.abs(ra_11) > 5 ) & ( Math.abs(ra) > 5 ) )
            | In 2021, !{place.name} was ranked 
            | #[+value(jointrank(rev_rank(ra, 22), s[i], "", place, "")[0])]
            | #[+value(ud(rev_rank(ra, 22), (ord(Math.abs(rev_rank(ra, 22)))+"highest"), (ord(Math.abs(rev_rank(ra, 22)))+"lowest")))] 
            | out of the 22 Welsh local authority areas for the #[+percentASR(i)] of
            | #[+value(topics[s[i][0]][s[i][3]].adj_noun_s)]. 
            | In 2011, it was ranked
            | #[+value(jointrank( rev_rank(ra_11, 22) , s[i], "", place, "_11")[0])]
            | #[+value(ord(Math.abs(rev_rank(ra_11, 22)))+ud(data[s[i][0]][s[i][1]+"_rank"][2011][s[i][3]],"highest", "lowest"))]
            | .
        else 
            | During this period, !{place.name} 
            | went from having the
            | #[+value(jointrank(ra_11, s[i], "", place, "_11")[0])]
            | #[+value(ord(Math.abs(ra_11))+ud(data[s[i][0]][s[i][1]+"_rank"][2011][s[i][3]],"highest", "lowest"))]
            | #[+alongside(jointrank(ra_11, s[i], "", place, "_11"))]
            | to the
            | #[+value(jointrank(ra, s[i], "", place, "")[0])]
            | #[+value(ud(ra, (ord(Math.abs(ra))+"highest"), (ord(Math.abs(ra))+"lowest")))] #[+percentASR(i)] of #[+value(topics[s[i][0]][s[i][3]].adj_noun_s)]
            | #[+alongside(jointrank(ra, s[i], "", place, ""))] 
            - let last_letter = topics[s[i][0]][s[i][3]].adj_noun_s[topics[s[i][0]][s[i][3]].adj_noun_s.length-1]
            | !{ (last_letter==")") ? "" : "(" } out of all
            | #[+value((country=="England")?"309 English":"22 Welsh")] local authority areas !{ (last_letter==")") ? "" : ")" }
            | .

mixin sent1Perc(i)
    - console.log("sent1Perc")
    //-sent1Perc
    if (local_2021>15)
        p 
            | Of !{removeThe(place.name)} #[+value(topics[s[i][0]].measure_s_nb)],
            | #[+pc(local_2021)] 
            | #[+value(topics[s[i][0]][s[i][3]].verb_past_samp)] in 2021, 
            if (pcnoprint(local_2011) == pcnoprint(local_2021))
                | the same #[+percentASR(i)] as in 2011.
            else if (Math.abs(local_change)<0.3)
                | a similar #[+percentASR(i)] as in 2011 (#[+pc(local_2011)]).
            else
                if (local_change<0)
                    | down
                else
                    | up 
                | from 
                | #[+pc(local_2011)]
                | in 2011.
            if (['health', 'disability', 'care'].includes(s[i][0])) 
                | These are age-standardised proportions.
    else
        p 
            | In 2021, 
            | #[+pc(local_2021)] 
            | of !{removeThe(place.name)} #[+value(topics[s[i][0]].measure_s)]
            | #[+value(topics[s[i][0]][s[i][3]].verb_past_samp)].
            | This figure 
            if (pcnoprint(local_2011) == pcnoprint(local_2021))
                | was the same in 2011.
            else if (Math.abs(local_change)<0.3)
                | was at a similar level in 2011 (#[+pc(local_2011)]).
            else
                if (local_change<0)
                    | decreased
                else
                    | increased 
                | from 
                | #[+pc(local_2011)]
                | in 2011.
            if (['health', 'disability', 'care'].includes(s[i][0])) 
                | These are age-standardised proportions.

mixin sent1PercAlt(i)
    - console.log("sent1PercAlt")
    //- sent1PercAlt
    p 
        | The #[+percentASR(i)] of !{place.name} #[+value(topics[s[i][0]].measure_s)]
        | #[+value(topics[s[i][0]][s[i][3]].verb_past)] was #[+pc(local_2021)] in 2021 
        if (pcnoprint(local_2011) == pcnoprint(local_2021))
            | (the same level as in 2011).
        else
            | (#[+value(ud(local_change,'up','down'))]
            | from #[+pc(local_2011)]
            | in 2011).

mixin sent2Perc(i)
    - console.log("sent2Perc")
    //-sent2Perc
    if (pcnoprint(local_2011_other_variable1)==pcnoprint(local_2021_other_variable1))
        recordSaid('s2pA')
        | The #[+percentASR(i)] 
        | #[+value((topics[s[i][0]].measure_s=='households')?'that':'who')] 
        | #[+value(topic(i, other_1).verb_past_samp)]
        | remained at #[+pc(local_2011_other_variable1)]
    else
        | In 2021,
        if (local_2021_other_variable1<1.7)
            | #[+pc(local_2021_other_variable1)] of
            | #[+value(topics[s[i][0]].measure_s)]
        else 
            | #[+value(get_word((local_2021_other_variable1)/100, 'frac')[0])]
            | #[+value(get_word((local_2021_other_variable1)/100, 'frac')[1])]
            | #[+value((topics[s[i][0]].measure_s=='households')?'households':'people')]
            | (#[+pc(local_2021_other_variable1)])
        | #[+value(topic(i, other_1).verb_past_samp)],
        | compared with
        | #[+pc(local_2011_other_variable1)]
        | in 2011. 
    if (chains[s[i][3]].length>1)
        if (hasSaid('s2pA'))
            | , while
        | the #[+percentASR(i)] of
        | #[+value(topic(i, other_2).clausal_modifier)]
        | #[+updownrem('increased', 'decreased', local_2011_other_variable2, local_2021_other_variable2)]
        | .
        deleteSaid('s2pA')
    | .

mixin updownrem(w1, w2, fig1, fig2)
    - console.log("updownrem")
    //-updownrem
    if (pcnoprint(fig1) == pcnoprint(fig2))
        | remained at #[+pc(fig2)]
    else
        | #[+value(ud(fig2-fig1, w1, w2))]
        | from 
        | #[+pc(fig1)]
        | to 
        | #[+pc(fig2)]

mixin topRank(i)
    - console.log("topRank")
    //- topRank
    | !{place.name} saw #[+value(country+"'s")] 
    | #[+value(jointrank(national_rank_change, s[i], "", place, "_change")[0])]
    | #[+value(udord(national_rank_change, 'largest rise', 'largest fall'))]
    | #[+alongside(jointrank(national_rank_change, s[i], "", place, "_change"))]
    | in the #[+percentASR(i)] of #[+value(topic(i).adj_noun)]
    | .
    if (Math.abs(national_rank_2021)<11)
        | #[+nowHasCou(i)]


mixin topRankLoc(i)
    - console.log("topRankLoc")
    //-topRankLoc
    | !{place.name} saw #[+value(parent+"'s")] 
    | #[+value(jointrank(regional_rank_change, s[i], "_local", place, "_change")[0])]
    | #[+value(udord(regional_rank_change, 'largest rise', 'largest fall'))]
    | #[+alongside(jointrank(regional_rank_change, s[i], "_local", place, "_change"))]
    | in the #[+percentASR(i)] of #[+value(topic(i).adj_noun)]
    | .
    if (Math.abs(regional_rank_2021)<11)
        | #[+nowHasReg(i)]


mixin nearCompare(i)
    //- FINDMENEARCOMPARE
    if ((Math.abs(local_change) < 0.3) | (Math.abs(near_change) < 0.3) )
        | The #[+percentASR(i)] of #[+value(topic(i).adj_noun)]
        if (Math.abs(near_change) < 0.3) 
            if (Math.abs(near_change) < 0.1) 
                | remained #[+pc(near.data[s[i][0]][s[i][1]]['2021'][s[i][3]])]
            else 
                | was #[+pc(near.data[s[i][0]][s[i][1]]['2021'][s[i][3]])] (similar to 2011)
        else 
            | #[+value(ud(near_change, 'increased', 'fell'))] from 
            | #[+pc(near.data[s[i][0]][s[i][1]]['2011'][s[i][3]])] 
            | to #[+pc(near.data[s[i][0]][s[i][1]]['2021'][s[i][3]])] 
        | in #[+nearbyname]. 
        | Across #[+value(country)], the #[+percentASR(i)] 
        if (pcnoprint(national_2011) == pcnoprint(national_2021))
            | remained at #[+pc(national_2021)].
        else
            | #[+value(ud(national_change, 'increased', 'fell'))]
            | from #[+pc(national_2011)] to 
            | #[+pc(national_2021)].
    else 
        if ( Math.sign(local_change) != Math.sign(near_change) )
            | While the #[+percentASR(i)] of #[+value(topic(i).adj_noun)]
            | #[+value(uds_s(local_change, 'increased', 'fell', 'remained stable'))] here, 
            | in #[+nearbyname] the #[+percentASR(i)] 
            | #[+value(uds_s(near_change, 'increased', 'fell', 'remained stable'))]
            if (pcnoprint((near_2011)) == pcnoprint((near_2021)) )
                | (#[+pc(near_2021)] in 2011 and 2021).
            else
                | from #[+pc(near_2011)] in 2011 to 
                | #[+pc(near_2021)] in 2021.
            | Across #[+value(country)], the #[+percentASR(i)] 
            if (pcnoprint(national_2011) == pcnoprint(national_2021))
                | remained at #[+pc(national_2021)].
            else
                | #[+value(ud(national_change, 'increased', 'fell'))]
                | from #[+pc(national_2011)] to 
                | #[+pc(national_2021)].
        else
            if ((Math.abs(local_change - near_change) < 0.3))
                | The #[+value(ud(local_change, 'increase', 'decrease'))] 
                | in the #[+percentASR(i)] of #[+value(topic(i).adj_noun)] 
                | #[+value(place.preposition)] #[+value(place.name)]
                | (#[+value(Math.abs(local_change), {'FORMAT': "0.0"})] percentage points)
                | was similar to the 
                | #[+value(ud(near_change, 'increase', 'decrease'))] in #[+nearbyname]
                | (#[+value(Math.abs(near_change), {'FORMAT': "0.0"})] percentage points)
                | .
            else if (Math.abs(local_change) > Math.abs(near_change))
                | The #[+value(ud(local_change, 'increase', 'decrease'))] 
                | in the #[+percentASR(i)] of #[+value(topic(i).adj_noun)] 
                | was greater #[+value(place.preposition)] #[+value(place.name)]
                | (#[+value(Math.abs(local_change), {'FORMAT': "0.0"})] percentage points)
                | than in #[+nearbyname]
                | (#[+value(Math.abs(near_change), {'FORMAT': "0.0"})] percentage points)
                | .
            else
                | The #[+value(ud(local_change, 'increase', 'decrease'))] 
                | in the #[+percentASR(i)] of #[+value(topic(i).adj_noun)] 
                | was greater in #[+nearbyname]
                | (#[+value(Math.abs(near_change), {'FORMAT': "0.0"})] percentage points)
                | than #[+value(place.preposition)] #[+value(place.name)]
                | (#[+value(Math.abs(local_change), {'FORMAT': "0.0"})] percentage points)
                | .
            | In #[+nearbyname], the #[+percentASR(i)] 
            if (pcnoprint(near_2011) == pcnoprint(near_2021))
                | remained at #[+pc(near_2021)].
            else
                | #[+value(ud(near_change, 'increased', 'fell'))]
                | from #[+pc(near_2011)] in 2011 to 
                | #[+pc(near_2021)] in 2021,
            | while across #[+value(country)], the #[+percentASR(i)] 
            if (pcnoprint(national_2011) == pcnoprint(national_2021))
                | remained at #[+pc(national_2021)].
            else
                | #[+value(ud(national_change, 'increased', 'fell'))]
                | from #[+pc(national_2011)] to 
                | #[+pc(national_2021)].

mixin regionCompare(i)
    //- FINDMEREGIONCOMPARE
    if ((Math.abs(local_change) < 0.3) | (Math.abs(regional_change) < 0.3) )
        | The #[+percentASR(i)] of #[+value(topic(i).adj_noun)]
        if (Math.abs(regional_change) < 0.3) 
            if (Math.abs(regional_change) < 0.1) 
                | remained #[+pc(rgn.data[s[i][0]][s[i][1]]['2021'][s[i][3]])] 
            else 
                | was #[+pc(rgn.data[s[i][0]][s[i][1]]['2021'][s[i][3]])] (similar to 2011) 
        else 
            | #[+value(ud(regional_change, 'increased', 'fell'))] from 
            | #[+pc(rgn.data[s[i][0]][s[i][1]]['2011'][s[i][3]])] 
            | to #[+pc(rgn.data[s[i][0]][s[i][1]]['2021'][s[i][3]])] 
        | across !{parent}. 
        | Across #[+value(country)], the #[+percentASR(i)] 
        if (pcnoprint(national_2011) == pcnoprint(national_2021))
            | remained at #[+pc(national_2021)].
        else
            | #[+value(ud(national_change, 'increased', 'fell'))]
            | from #[+pc(national_2011)] to 
            | #[+pc(national_2021)].
    else 
        if ( Math.sign(local_change) != Math.sign(regional_change) )
            | While the #[+percentASR(i)] of #[+value(topic(i).adj_noun)]
            | #[+value(uds_s(local_change, 'increased', 'fell', 'remained stable'))] here, 
            | across #[+value(parent)] the #[+percentASR(i)] 
            | #[+value(uds_s(regional_change, 'increased', 'fell', 'remained stable'))]
            if (pcnoprint((regional_2011)) == pcnoprint((regional_2021)) )
                | (#[+pc(regional_2021)] in 2011 and 2021).
            else
                | from #[+pc(regional_2011)] in 2011 to 
                | #[+pc(regional_2021)] in 2021.
            | Across #[+value(country)], the #[+percentASR(i)] 
            if (pcnoprint(national_2011) == pcnoprint(national_2021))
                | remained at #[+pc(national_2021)].
            else
                | #[+value(ud(national_change, 'increased', 'fell'))]
                | from #[+pc(national_2011)] to 
                | #[+pc(national_2021)].
        else
            if ((Math.abs(local_change - regional_change) < 0.3))
                | The #[+value(ud(local_change, 'increase', 'decrease'))] 
                | in the #[+percentASR(i)] of #[+value(topic(i).adj_noun)] 
                | #[+value(place.preposition)] #[+value(place.name)]
                | (#[+value(Math.abs(local_change), {'FORMAT': "0.0"})] percentage points)
                | was similar to the 
                | #[+value(ud(regional_change, 'increase', 'decrease'))] across #[+value(parent)]
                | (#[+value(Math.abs(regional_change), {'FORMAT': "0.0"})] percentage points,
                if (pcnoprint(regional_2011) == pcnoprint(regional_2021))

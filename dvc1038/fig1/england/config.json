      "sm": {
        "top": 50,
        "right": 20,
        "bottom": 50,
        "left": 40
      },
      "md": {
        "top": 30,
        "right": 120,
        "bottom": 50,
        "left": 40
      },
      "lg": {
        "top": 30,
        "right": 140,
        "bottom": 50,
        "left": 40
      }
    },

    "aspectRatio": {
      "sm": [16, 10],
      "md": [16, 10],
      "lg": [16, 5]
    },

    "mobileBreakpoint": 500,
    "middleBreakpoint": 600,

    "x_ticks_every": {
      "sm": 14,
      "md": 14,
      "lg": 7
    },
    "y_num_ticks": {
      "sm": 5,
      "md": 5,
      "lg": 5
    },

    "lineMarkers": false


  }
}

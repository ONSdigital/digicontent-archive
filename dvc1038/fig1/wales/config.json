{
  "essential": {
    "graphic_data_url": "../data.csv",
    "dateFormat": "%d/%m/%Y",
    "legendLabels": ["All deaths - 2020","5 year average"],
    "colour_palette": ["#206095","#27A0CC"],
    "legendStyle": ["line", "line"],
    "plotLines": [{
      "key": "Wales",
      "colour": "#206095"
    }, {
      "key": "WalesMean",
      "colour": "#27A0CC",
      "strokedasharray": "10 12",
      "strokewidth":"2px"
    }

  ],
  "directLabels": [],
    "sourceText": ["Office for National Statistics"],
    "circles": false,
    "yAxisLabel": "Weekly deaths",
    "xAxisLabel": "Week ending",
    "yAxisScale": [0, 1500],
    "yAxisBreak": false,
    "yAxisBreakValue": {
      "sm": 12,
      "md": 10,
      "lg": 10
    }
  },

    "optional": {
      "margin": {
        "sm": {
          "top": 50,
          "right": 20,
          "bottom": 50,
          "left": 40
        },
        "md": {
          "top": 30,
          "right": 120,
          "bottom": 50,
          "left": 40
        },
        "lg": {
          "top": 30,
          "right": 140,
          "bottom": 50,
          "left": 40
        }
      },

      "aspectRatio": {
        "sm": [16, 10],
        "md": [16, 10],
        "lg": [16, 5]
      },

    "mobileBreakpoint": 500,
    "middleBreakpoint": 600,

    "x_ticks_every": {
      "sm": 14,
      "md": 14,
      "lg": 7
    },
    "y_num_ticks": {
      "sm": 3,
      "md": 3,
      "lg": 3
    },

    "lineMarkers": false


  }
}

-01T00:00:00.000Z","y":2.988969517},{"z":"United Kingdom ","x":"2024-03-31T23:00:00.000Z","y":2.926417676},{"z":"United Kingdom ","x":"2024-04-30T23:00:00.000Z","y":3.284340479},{"z":"United Kingdom ","x":"2024-05-31T23:00:00.000Z","y":3.468581082},{"z":"United Kingdom ","x":"2024-06-30T23:00:00.000Z","y":3.432310812},{"z":"United Kingdom ","x":"2024-07-31T23:00:00.000Z","y":3.367594358}],"legend":"true","labels":"false","selected":"Broadland","xScale":"time","xFormatTickString":"%b-%y","colors":["#206095","darkgrey","#A8BD3A","#F66068","#27A0CC","#118C7B","#746CB1","#22D0B6"],"xTicks":"5","yAxisLabel":"Adverts per 100 working-age residents","forceTicks":"true","padding-right":"20","padding-left":"20","content":"undefined"},{"id":"occupations","type":"Section","imgSrc":"./img/job_adverts.svg","title":"The most-advertised occupations in Broadland","content":"<p>Care workers and home carers were the most commonly advertised jobs in Broadland. </p><p>In Quarter 2 (April to June) 2024, adverts for care workers and home carers made up 9.8% of all live adverts in Broadland, the highest percentage of any single occupation. </p>"},{"id":"chartOccupationShare","type":"Chart","chartType":"bar","title":"The most advertised jobs in Broadland","subtitle":"Occupations with the largest percentage of all live job adverts in Quarter 2 (April to June) 2024","footer":"Source: Textkernel, Office for National Statistics","data":[{"x":0.097672147,"y":"Care workers and home carers"},{"x":0.063161322,"y":"Nursing auxiliaries and assistants"},{"x":0.043626892,"y":"Cleaners and domestics"}],"selected":"Broadland","padding-left":"230","xTicks":"5","wrapTicks":"true","xFormatTickString":",.1%","padding-right":"20"},{"type":"Section","content":"<p>Meanwhile, the occupation that saw demand rise the most over the year in Broadland was cleaners and domestics. </p><p>Adverts for cleaners and domestics made up 4.4% of all live adverts in  in Quarter 2 (April to June) 2024, an increase of 2.1 percentage points from the same period in 2023.</p>"},{"id":"chartOccupationUp","type":"Chart","chartType":"bar","title":"Jobs with the biggest increase in demand in Broadland","subtitle":"Top 3 jobs in Broadland with the biggest percentage point increase in demand from  Quarter 2 (April to June) 2023 to Quarter 2 2024","footer":"Source: Textkernel, Office for National Statistics","data":[{"x":2.111948865,"y":"Cleaners and domestics"},{"x":1.019812597,"y":"Chefs"},{"x":0.831868439,"y":"Kitchen and catering assistants"}],"selected":"Broadland","padding-left":"230","formatTickCheck":"true","xFormatTickString":".1f","xAxisLabel":"percentage point change","xTicks":"5","padding-right":"20"},{"type":"Section","content":"<p>This analysis includes over 400 different job categories (using four-digit <a href=\"https://www.ons.gov.uk/methodology/classificationsandstandards/standardoccupationalclassificationsoc/soc2020\">standard occupational classifications, or SOC</a> ). This means that when we look at shares of total adverts, many of the percentages are very small as demand in local areas is not concentrated to just a handful of occupations. Adverts are matched to occupations based on the advertised job title. More information is in <a href=\"https://www.ons.gov.uk/employmentandlabourmarket/peopleinwork/employmentandemployeetypes/methodologies/measuringlabourdemandvolumesacrosstheukusingtextkerneldatauserguide\"> our user guide.</a></p><p>Job advert volumes for all occupations in Broadland and for other local areas can be found in our <a href=\"https://www.ons.gov.uk/employmentandlabourmarket/peopleinwork/employmentandemployeetypes/datasets/labourdemandvolumesbystandardoccupationclassificationsoc2020uk\"> associated data tables</a>.  </p>"},{"type":"end","content":"<p><a href=\"#header-title\">Back to top</a></p>"},{"id":"skills","type":"Section","title":"How well-matched are local residents’ skills to advertised jobs in East Anglia?","imgSrc":"./img/skills_data.svg","content":"<p>We can use data on local skills (based on individuals' employment history) to explore how many adverts potentially could have been filled by people in the area.</p><p>For the rest of the analysis in this tool, we look at a larger area called an International Territorial Level 2 (ITL2). We do this because many people commute outside their local authority for work, and because data on skills are less reliable for smaller areas. </p><p>In some cases, ITL2 areas are very large, for example the country of Northern Ireland is one ITL2 area.  </p><p>Broadland is in the East Anglia ITL2 area.  </p><p>Of the 69,725 adverts in East Anglia across 2023, we estimate that 48% matched the skills of at least one person in the area who was not already working in that occupation. </p><p>For the purposes of this analysis, we only consider a person's skills to match an open advert if they have every skill associated with the role. In reality, people may have relevent skills not captured by our data, or be hired for a job without meeting every criteria. Further information on our methods are available in the <a href=\"https://www.ons.gov.uk/employmentandlabourmarket/peopleinwork/labourproductivity/methodologies/measuringskillandqualificationsuitabilityintheuklabourmarketuserguide\">user guide.</a></p>"},{"id":"scatterchart","type":"Chart","title":"In 2023, 48% of job adverts in East Anglia could have been filled by local people","subtitle":"Proportion of jobs that matched the skills of people in the area, East Anglia ITL2, 2023","footer":"Source: Textkernel, Annual Population Survey from the Office for National Statistics, Occupational Information Network (O*NET)","chartType":"scatter","data":[{"x":0.5266,"idKey":"TLH2","labelKey":"Bedfordshire and Hertfordshire"},{"x":0.56064,"idKey":"TLJ1","labelKey":"Berkshire, Buckinghamshire and Oxfordshire"},{"x":0.34455,"idKey":"TLD6","labelKey":"Cheshire"},{"x":0.47304,"idKey":"TLK3","labelKey":"Cornwall and the Isles of Scilly"},{"x":0.41287,"idKey":"TLD1","labelKey":"Cumbria"},{"x":0.55029,"idKey":"TLF1","labelKey":"Derbyshire and Nottinghamshire"},{"x":0.61447,"idKey":"TLK4","labelKey":"Devon"},{"x":0.55157,"idKey":"TLK2","labelKey":"Dorset and Somerset"},{"x":0.47905,"idKey":"TLH1","labelKey":"East Anglia"},{"x":0.55384,"idKey":"TLL2","labelKey":"East Wales"},{"x":0.45084,"idKey":"TLE1","labelKey":"East Yorkshire and Northern Lincolnshire"},{"x":0.59358,"idKey":"TLM7","labelKey":"Eastern Scotland"},{"x":0.47969,"idKey":"TLH3","labelKey":"Essex"},{"x":0.55881,"idKey":"TLK1","labelKey":"Gloucestershire, Wiltshire and the Bath/Bristol area"},{"x":0.48207,"idKey":"TLD3","labelKey":"Greater Manchester"},{"x":0.63417,"idKey":"TLJ3","labelKey":"Hampshire and the Isle of Wight"},{"x":0.47701,"idKey":"TLG1","labelKey":"Herefordshire, Worcestershire and Warwickshire"},{"x":0.46966,"idKey":"TLM6","labelKey":"Highlands and Islands"},{"x":0.38306,"idKey":"TLJ4","labelKey":"Kent"},{"x":0.51239,"idKey":"TLD4","labelKey":"Lancashire"},{"x":0.51758,"idKey":"TLF2","labelKey":"Leicestershire, Rutland and Northamptonshire"},{"x":0.29794,"idKey":"TLF3","labelKey":"Lincolnshire"},{"x":0.65779,"idKey":"TLI","labelKey":"London"},{"x":0.51901,"idKey":"TLD7","labelKey":"Merseyside"},{"x":0.31734,"idKey":"TLM5","labelKey":"North Eastern Scotland"},{"x":0.41866,"idKey":"TLE2","labelKey":"North Yorkshire"},{"x":0.60184,"idKey":"TLN0","labelKey":"Northern Ireland"},{"x":0.55702,"idKey":"TLC2","labelKey":"Northumberland, and Tyne and Wear"},{"x":0.52237,"idKey":"TLG2","labelKey":"Shropshire and Staffordshire"},{"x":0.46758,"idKey":"TLE3","labelKey":"South Yorkshire"},{"x":0.55924,"idKey":"TLM9","labelKey":"Southern Scotland"},{"x":0.56828,"idKey":"TLJ2","labelKey":"Surrey, East and West Sussex"},{"x":0.59059,"idKey":"TLC1","labelKey":"Tees Valley and Durham"},{"x":0.38339,"idKey":"TLM8","labelKey":"West Central Scotland"},{"x":0.55441,"idKey":"TLG3","labelKey":"West Midlands"},{"x":0.72493,"idKey":"TLL1","labelKey":"West Wales and The Valleys"},{"x":0.46104,"idKey":"TLE4","labelKey":"West Yorkshire"}],"hover":"true","labels":"true","height":"200px","selected":"TLH1","idKey":"idKey","labelKey":"labelKey","xFormatTickString":".0%","xTicks":"10","xMin":"0","padding-right":"20","padding-left":"20","padding-top":"50","avgLine":"0.74"},{"type":"Section","content":"<p>Compared with the proportion of adverts that matched the skills of people in other areas, East Anglia placed 24th of 37 UK ITLs. This suggests employers may have been less likely to find people with relevent skills nearby, compared with other areas of the UK. </p>"},{"type":"HighlightBox","content":"<h4>Why do these numbers matter?</h4><p>If the jobs being advertised in an area do not match the skills of the resident population, then vacancies might remain unfilled, or employers may have to look further afield to find workers.</p><p>However, it's worth noting that not all adverts need to be filled by residents from that area. People may commute from further afield, work remotely, or relocate to fill roles.</p><p>This is less likely in areas that are not bordering as many other areas, or any, such as Northern Ireland.</p><p>More information about how these measures were calculated is available in the <a href=\"https://www.ons.gov.uk/employmentandlabourmarket/peopleinwork/employmentandemployeetypes/articles/whichskillsareemployersseekinginyourarea/2024-11-05#data-sources-and-quality\">data sources and quality section</a>. </p>"},{"type":"Section","content":"<p>We can also estimate the percentage of the population that stood to benefit from live adverts in their area. </p><p>In East Anglia, we estimate that 7% of working-age residents would have had the relevant skills for at least one job advertised in the area in 2023, excluding the occupation they already worked in. </p>"},{"id":"scatterchart","type":"Chart","title":"In 2023, 7% of working-age residents in East Anglia had the skills to fill at least one job advert","subtitle":"Proportion of working-age residents with the skills to fill at least one job advert, East Anglia ITL2, 2023","footer":"Source: Textkernel, Annual Population Survey from the Office for National Statistics, Occupational Information Network (O*NET)","chartType":"scatter","data":[{"x":0.06176,"idKey":"TLH2","labelKey":"Bedfordshire and Hertfordshire"},{"x":0.07759,"idKey":"TLJ1","labelKey":"Berkshire, Buckinghamshire and Oxfordshire"},{"x":0.05174,"idKey":"TLD6","labelKey":"Cheshire"},{"x":0.12724,"idKey":"TLK3","labelKey":"Cornwall and the Isles of Scilly"},{"x":0.05455,"idKey":"TLD1","labelKey":"Cumbria"},{"x":0.0818,"idKey":"TLF1","labelKey":"Derbyshire and Nottinghamshire"},{"x":0.10217,"idKey":"TLK4","labelKey":"Devon"},{"x":0.07521,"idKey":"TLK2","labelKey":"Dorset and Somerset"},{"x":0.06965,"idKey":"TLH1","labelKey":"East Anglia"},{"x":0.07499,"idKey":"TLL2","labelKey":"East Wales"},{"x":0.07852,"idKey":"TLE1","labelKey":"East Yorkshire and Northern Lincolnshire"},{"x":0.07151,"idKey":"TLM7","labelKey":"Eastern Scotland"},{"x":0.05359,"idKey":"TLH3","labelKey":"Essex"},{"x":0.06637,"idKey":"TLK1","labelKey":"Gloucestershire, Wiltshire and the Bath/Bristol area"},{"x":0.07561,"idKey":"TLD3","labelKey":"Greater Manchester"},{"x":0.08461,"idKey":"TLJ3","labelKey":"Hampshire and the Isle of Wight"},{"x":0.05474,"idKey":"TLG1","labelKey":"Herefordshire, Worcestershire and Warwickshire"},{"x":0.11944,"idKey":"TLM6","labelKey":"Highlands and Islands"},{"x":0.05003,"idKey":"TLJ4","labelKey":"Kent"},{"x":0.06779,"idKey":"TLD4","labelKey":"Lancashire"},{"x":0.07738,"idKey":"TLF2","labelKey":"Leicestershire, Rutland and Northamptonshire"},{"x":0.05516,"idKey":"TLF3","labelKey":"Lincolnshire"},{"x":0.09298,"idKey":"TLI","labelKey":"London"},{"x":0.07754,"idKey":"TLD7","labelKey":"Merseyside"},{"x":0.06659,"idKey":"TLM5","labelKey":"North Eastern Scotland"},{"x":0.06692,"idKey":"TLE2","labelKey":"North Yorkshire"},{"x":0.0543,"idKey":"TLN0","labelKey":"Northern Ireland"},{"x":0.05817,"idKey":"TLC2","labelKey":"Northumberland, and Tyne and Wear"},{"x":0.06799,"idKey":"TLG2","labelKey":"Shropshire and Staffordshire"},{"x":0.06104,"idKey":"TLE3","labelKey":"South Yorkshire"},{"x":0.07521,"idKey":"TLM9","labelKey":"Southern Scotland"},{"x":0.07715,"idKey":"TLJ2","labelKey":"Surrey, East and West Sussex"},{"x":0.05743,"idKey":"TLC1","labelKey":"Tees Valley and Durham"},{"x":0.05403,"idKey":"TLM8","labelKey":"West Central Scotland"},{"x":0.07061,"idKey":"TLG3","labelKey":"West Midlands"},{"x":0.09005,"idKey":"TLL1","labelKey":"West Wales and The Valleys"},{"x":0.0634,"idKey":"TLE4","labelKey":"West Yorkshire"}],"hover":"true","labels":"true","height":"200px","selected":"TLH1","idKey":"idKey","labelKey":"labelKey","xFormatTickString":".0%","xTicks":"10","xMin":"0","padding-right":"20","padding-left":"20","padding-top":"50","avgLine":"0.07"},{"type":"Section","content":"<p>This places East Anglia 19th of 37 UK ITLs, in terms of how many residents met the skills requirements for open job adverts in the area.</p><p> </p>"},{"type":"end","content":"<p><a href=\"#header-title\">Back to top</a></p>"},{"id":"health","type":"Section","title":"Adverts for health and social care jobs in East Anglia","content":"<p>Providing sufficient health and social care services is an important challenge for many areas of the UK. This section focusses on demand for occupations that are considered important by the Department for Health and Social Care (DHSC), and workforces' ability to meet that demand in 2023. </p><p>Many health and social care jobs require specialised skills and training, which can make them harder to fill than other occupations.  </p><p>We estimate that in 2023, 54% of health and social care job adverts in East Anglia matched the skills of at least one person not currently working in the same occupation. </p>"},{"id":"scatterchart","type":"Chart","title":"54% of health and social care job adverts in East Anglia could have been filled by people in the area","subtitle":"Proportion of health and social care jobs that could have been filled by people in the area, East Anglia ITL2, 2023","footer":"Source: Textkernel, Annual Population Survey from the Office for National Statistics, Occupational Information Network (O*NET)","chartType":"scatter","data":[{"x":0.72164,"idKey":"TLH2","labelKey":"Bedfordshire and Hertfordshire"},{"x":0.59432,"idKey":"TLJ1","labelKey":"Berkshire, Buckinghamshire and Oxfordshire"},{"x":0.38836,"idKey":"TLD6","labelKey":"Cheshire"},{"x":0.51168,"idKey":"TLK3","labelKey":"Cornwall and the Isles of Scilly"},{"x":0.56014,"idKey":"TLD1","labelKey":"Cumbria"},{"x":0.81509,"idKey":"TLF1","labelKey":"Derbyshire and Nottinghamshire"},{"x":0.68641,"idKey":"TLK4","labelKey":"Devon"},{"x":0.50634,"idKey":"TLK2","labelKey":"Dorset and Somerset"},{"x":0.53596,"idKey":"TLH1","labelKey":"East Anglia"},{"x":0.65366,"idKey":"TLL2","labelKey":"East Wales"},{"x":0.54671,"idKey":"TLE1","labelKey":"East Yorkshire and Northern Lincolnshire"},{"x":0.57929,"idKey":"TLM7","labelKey":"Eastern Scotland"},{"x":0.4962,"idKey":"TLH3","labelKey":"Essex"},{"x":0.67636,"idKey":"TLK1","labelKey":"Gloucestershire, Wiltshire and the Bath/Bristol area"},{"x":0.54886,"idKey":"TLD3","labelKey":"Greater Manchester"},{"x":0.75519,"idKey":"TLJ3","labelKey":"Hampshire and the Isle of Wight"},{"x":0.43356,"idKey":"TLG1","labelKey":"Herefordshire, Worcestershire and Warwickshire"},{"x":0.38302,"idKey":"TLM6","labelKey":"Highlands and Islands"},{"x":0.33702,"idKey":"TLJ4","labelKey":"Kent"},{"x":0.4973,"idKey":"TLD4","labelKey":"Lancashire"},{"x":0.4508,"idKey":"TLF2","labelKey":"Leicestershire, Rutland and Northamptonshire"},{"x":0.31175,"idKey":"TLF3","labelKey":"Lincolnshire"},{"x":0.67377,"idKey":"TLI","labelKey":"London"},{"x":0.59186,"idKey":"TLD7","labelKey":"Merseyside"},{"x":0.61734,"idKey":"TLM5","labelKey":"North Eastern Scotland"},{"x":0.46089,"idKey":"TLE2","labelKey":"North Yorkshire"},{"x":0.62639,"idKey":"TLN0","labelKey":"Northern Ireland"},{"x":0.63619,"idKey":"TLC2","labelKey":"Northumberland, and Tyne and Wear"},{"x":0.58636,"idKey":"TLG2","labelKey":"Shropshire and Staffordshire"},{"x":0.59098,"idKey":"TLE3","labelKey":"South Yorkshire"},{"x":0.58758,"idKey":"TLM9","labelKey":"Southern Scotland"},{"x":0.53539,"idKey":"TLJ2","labelKey":"Surrey, East and West Sussex"},{"x":0.70794,"idKey":"TLC1","labelKey":"Tees Valley and Durham"},{"x":0.4789,"idKey":"TLM8","labelKey":"West Central Scotland"},{"x":0.47246,"idKey":"TLG3","labelKey":"West Midlands"},{"x":0.74952,"idKey":"TLL1","labelKey":"West Wales and The Valleys"},{"x":0.60649,"idKey":"TLE4","labelKey":"West Yorkshire"}],"hover":"true","labels":"true","height":"200px","selected":"TLH1","idKey":"idKey","labelKey":"labelKey","xFormatTickString":".0%","xTicks":"10","xMin":"0","padding-right":"20","padding-left":"20","padding-top":"50","avgLine":"0.78"},{"type":"Section","content":"<p>This puts East Anglia 23rd of the 37 UK ITLs, in terms of the proportion of health and social care adverts we estimate could be filled by people in the area.</p>"},{"type":"Section","title":"Adverts for care workers and home carers were the most common of all health and social care occupations in East Anglia","content":"<p>There were up to 2,320 adverts for care workers and home carers live simultaneously  in East Anglia in 2023. This was more than any other health and social care occupation.  </p><p>We estimate that of all people in East Anglia with skills to do a job they did not already do, 10% met the requirements for a care workers and home carers job advert. </p><p>This places East Anglia 14th of the 37 UK ITLs.</p>"},{"type":"end","content":"<p><a href=\"#header-title\">Back to top</a></p>"},{"type":"HighlightBox","content":"<h4>Tell us what you think </h4><p>Are you interested in further analysis of job adverts and local workforce skills in other sectors of the UK economy? We would welcome your thoughts and feedback. Please contact Economic.Wellbeing@ons.gov.uk  </p>"},{"type":"Section","title":"Further information ","content":"<p>We use snapshot advert data in this tool – this reflects the average number of live adverts in a given time period, not new adverts posted.  </p><p>There are usually 43 ITLs in the UK, but because we have combined all areas of London into one region, in this tool there are 37. More information about our methods is available in the <a href=\"https://www.ons.gov.uk/employmentandlabourmarket/peopleinwork/labourproductivity/methodologies/measuringskillandqualificationsuitabilityintheuklabourmarketuserguide\">accompanying user guide</a>. </p>"}],"place":{"areacd":"E07000144","areanm":"Broadland","areatype":"LA","occ_share_up_1":"Cleaners and domestics","occ_share_up_1_value":2.111948865,"occ_share_up_1_old_perc":0.022507404,"occ_share_up_1_new_perc":0.043626892,"occ_share_up_2":"Chefs","occ_share_up_2_value":1.019812597,"occ_share_up_2_old_perc":0.005429418,"occ_share_up_2_new_perc":0.015627544,"occ_share_up_3":"Kitchen and catering assistants","occ_share_up_3_value":0.831868439,"occ_share_up_3_old_perc":0.013820336,"occ_share_up_3_new_perc":0.02213902,"occ_share_down_1":"Teaching assistants","occ_share_down_1_value":-0.844314486,"occ_share_down_1_old_perc":1.332675222,"occ_share_down_1_new_perc":0.488360736,"occ_share_down_2":"IT managers","occ_share_down_2_value":-0.597522779,"occ_share_down_2_old_perc":1.085883514,"occ_share_down_2_new_perc":0.488360736,"occ_share_down_3":"Other administrative occupations n.e.c.","occ_share_down_3_value":-0.490144482,"occ_share_down_3_old_perc":0.93780849,"occ_share_down_3_new_perc":0.447664008,"parentcd":"TLH1","parentnm":"East Anglia","time_2017-06":0.268961627,"time_2017-07":0.296562932,"time_2017-08":0.284071831,"time_2017-09":0.231018226,"time_2017-10":0.201469383,"time_2017-11":0.187366527,"time_2017-12":0.217049682,"time_2018-01":0.284931764,"time_2018-02":0.267186307,"time_2018-03":0.30368168,"time_2018-04":0.268927371,"time_2018-05":0.295646
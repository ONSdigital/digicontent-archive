geom_vline(xintercept = 1, colour = "#666666", size=1.05) +
theme(axis.title.y=element_blank(),axis.text.y=element_blank(),
axis.ticks.y = element_blank(), axis.ticks.x.top = element_blank()) +   ##This removes left yaxis information
scale_y_discrete("Unadjusted\nConfounder adjusted\nFully adjusted", position="right") +       ##This adds yaxis title on the right to use as horizontal line labels
theme(axis.title.y.right = element_text(angle=0, vjust=0.993, size=10, colour="#707071", ##This styles the labels. Use a combo of vjust and margin to adjust position.
hjust=0, lineheight = 1,
margin = margin(0,0,0,-3))) +
facet_wrap(~exposure_category, nrow = 11, strip.position = "left",
labeller = label_wrap_gen(multi_line=FALSE)) + ##Add this if you want facet labels to be across one line - labeller = label_wrap_gen(multi_line=FALSE
theme(strip.text.y.left = element_text(size=12, face="plain",
angle = 0, colour="#707071")) + ##This styles region labels
xlab("Likelihood of experiencing low life satisfaction") +
theme(axis.title.x.bottom = element_text(face="bold", size=10)) +
scale_x_continuous(breaks=c(0.8,1.0,1.2,1.4,1.6),
labels=c("0.8x","Just as likely","1.2x","1.4x","1.6x"),
sec.axis = sec_axis(~ ., breaks = c(0.89, 1.12), labels = c(as.character(expression("\u25C0 Less likely")),as.character(expression("More likely \u25B6"))))) +
theme(axis.text.x.top = element_text(face="bold", size=10)) + ##This stlyes Less/More likely
theme(axis.text.x= element_text(size=10)) +
labs(title = paste0("Reference category = ",mods$ref), colour="#707071") +
labs(subtitle = "Estimates with 95% confidence intervals") +## Adds label to graph
theme(plot.subtitle=element_text(size=12))+
theme(plot.title.position = "plot")
## Save graph
ggsave(paste0(filepath,"/odds.png"),
width = 8.5, height = 9)
